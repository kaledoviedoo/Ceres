# =============================================================================
# CERES — variables de entorno (copiar a .env y completar)
#
# .env ESTA EN .gitignore Y NUNCA DEBE COMMITEARSE.
# Este archivo solo contiene marcadores de posicion, nunca valores reales.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Local (docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://ceres:ceres@localhost:5432/ceres
#
# Supabase — Dashboard > Project Settings > Database > Connection string > URI.
# Se usa el POOLER (puerto 6543, modo transaction) porque la conexion directa
# al puerto 5432 solo resuelve por IPv6 en los proyectos nuevos.
# `?sslmode=require` es obligatorio contra Supabase.
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Supabase (RESERVADAS: hoy no las lee ningun componente) -------------------
# El backend habla con PostgreSQL por DATABASE_URL y el frontend solo con
# FastAPI. Ninguna de estas tres variables se usa todavia; quedan documentadas
# para cuando exista autenticacion o acceso directo a la API de Supabase.
#
# PUBLICO: identifica el proyecto, no da acceso.
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
#
# PUBLICO: clave de cliente. Solo concede lo que permitan las politicas RLS.
# SUPABASE_ANON_KEY=
#
# SECRETO. NUNCA en el frontend, NUNCA en el repositorio, NUNCA en un log.
# Salta todas las politicas RLS: quien la tenga puede leer y escribir todo.
# SUPABASE_SERVICE_ROLE_KEY=

# --- API ---------------------------------------------------------------------
CERES_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# --- Datos sinteticos --------------------------------------------------------
# Seed fija: garantiza que generate_demo_data.py siempre produzca el mismo dataset.
CERES_DEMO_SEED=42

# --- Tests contra PostgreSQL real --------------------------------------------
# Los tests de apps/api/tests/postgres/ SOLO se ejecutan si esta variable esta
# definida; sin ella se saltan. Vacian tablas enteras (TRUNCATE), asi que
# tests/postgres/guard.py rechaza cualquier destino que no sea una base de
# test: nunca la de DATABASE_URL, nunca un host de Supabase, y fuera de eso
# local o con nombre terminado en _test. Ninguna variable levanta esa barrera.
#
# Destino esperado: un PostgreSQL local con una base `ceres_test` migrada y con
# el seed de demo aplicado (ver README, "Tests").
# TEST_DATABASE_URL=postgresql+psycopg://ceres:<PASSWORD>@localhost:5432/ceres_test

# Si la base de test guarda ademas un dataset (mas de 100 predicciones, cosechas
# u observaciones sin autor), la limpieza se salta salvo que se autorice con
# esta variable. Solo tiene efecto sobre un destino que la barrera ya acepta.
# CERES_PG_TESTS_MAY_TRUNCATE=1
